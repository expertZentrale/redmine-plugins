        },
        {
          "file": "09-issue-list",
          "url": "/projects/screenshot/issues?set_filter=1&f[]=status_id&op[status_id]=o&c[]=status&c[]=priority&c[]=subject&c[]=helpdesk_kunde&c[]=helpdesk_sla_reaction&c[]=helpdesk_sla_solution&sort=id:desc&per_page=25",
          "clip": "table.list.issues",
          "note": "issue list with customer and SLA columns"
        },
        {
          "file": "10-contact-profile",
          "url": "/projects/screenshot/helpdesk_contacts/{contact}/edit",
