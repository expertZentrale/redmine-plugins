    "helpdesk": {
      "login": {
        "user": "screenshot-demo",
        "password": "screenshots"
      },
      "prep": "tools/capture/prep/run.sh helpdesk (after the plugin's seed_screenshot_demo.rb)",
      "shots": [
        {
          "file": "01-sla-dashboard",
          "url": "/projects/screenshot/helpdesk_sla_statistics",
