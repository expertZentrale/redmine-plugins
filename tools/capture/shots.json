        {
          "file": "05-issue-sidebar",
          "url": "/issues/{hero}",
          "actions": [
            {
              "eval": "document.querySelectorAll('#sidebar-wrapper > h3').forEach(h => { if (!h.nextElementSibling || !h.nextElementSibling.classList.contains('helpdesk-sidebar-card')) { h.nextElementSibling && h.nextElementSibling.remove(); h.remove(); } }); document.querySelector('#watchers') && document.querySelector('#watchers').remove(); document.querySelector('#sidebar-switch-panel') && document.querySelector('#sidebar-switch-panel').remove(); document.querySelector('#sidebar').style.cssText += 'align-self:flex-start;min-height:0;height:auto;';"
            }
          ],
          "clip": "#sidebar",
          "note": "Customer and AI Assistant cards only"
        },
        {
          "file": "06-reply",
          "url": "/issues/{hero}/edit?hd_reply=1",
          "actions": [
            {
              "waitMs": 600
            },
            {
              "fill": "#issue_notes",
              "value": {
                "en": "Hello Mr Hoffmann,\n\nthank you — we are looking into it and will get back to you shortly.\n\nKind regards",
                "de": "Hallo Herr Hoffmann,\n\nvielen Dank – wir sehen uns das an und melden uns in Kürze bei Ihnen.\n\nViele Grüße"
              }
            },
            {
              "waitMs": 300
            }
          ],
          "clip": "#hd-outgoing",
          "note": "armed reply: hazard border, original-recipients offer, attachments, signature after the body"
        },
        {
          "file": "07-project-settings",
          "url": "/projects/screenshot/settings/expert_helpdesk",
          "clip": "#tab-content-expert_helpdesk",
          "note": "project settings tab"
        },
